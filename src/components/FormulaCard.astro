---
interface Props {
    title: string;
    formula: string;
    description?: string;
}

const { title, description } = Astro.props;
---

<div class="bw-formula-card">
    <div class="bw-formula-card__header">{title}</div>
    <div class="bw-formula-card__formula">
        <slot />
    </div>
    {description && <div class="bw-formula-card__desc">{description}</div>}
</div>

<style>
    .bw-formula-card {
        margin: 1.5rem 0;
        border: 1px solid var(--accent-color, #4f46e5);
        border-left-width: 4px;
        border-radius: 0 12px 12px 0;
        background: color-mix(in srgb, var(--accent-color, #4f46e5) 4%, var(--bw-surface));
        overflow: hidden;
    }

    .bw-formula-card__header {
        padding: 8px 16px;
        font-weight: 600;
        font-size: 0.84rem;
        color: var(--accent-color, #4f46e5);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 1px solid color-mix(in srgb, var(--accent-color, #4f46e5) 12%, transparent);
    }

    .bw-formula-card__formula {
        padding: 14px 16px;
        overflow-x: auto;
    }

    .bw-formula-card__desc {
        padding: 0 16px 12px;
        font-size: 0.84rem;
        color: var(--bw-ink-muted);
    }
</style>
