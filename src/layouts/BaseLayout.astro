---
import '/node_modules/katex/dist/katex.min.css';

interface Props {
    title: string;
    description?: string;
    pageClass?: string;
    image?: string;
    activeNav?: string;
}

const { title, description = '', pageClass = '', image, activeNav = '' } = Astro.props;

const workerUrl = import.meta.env.PUBLIC_WORKER_URL || '';

const siteTitle = '129700 的笔记站';
const fullTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
const desc = description || '嵌入式开发与控制理论学习笔记';

const navItems = [
    { href: '/', label: '首页', id: 'home' },
    { href: '/archives', label: '归档', id: 'archives' },
    { href: '/categories', label: '分类', id: 'categories' },
    { href: '/tags', label: '标签', id: 'tags' },
    { href: '/links', label: '友链', id: 'links' },
];
---

<!DOCTYPE html>
<html lang="zh-CN" data-scheme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{fullTitle}</title>
    <meta name="description" content={desc}>
    <meta name="generator" content={Astro.generator} />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />
    {image && <meta property="og:image" content={image} />}

    <link rel="icon" type="image/png" href="/img/favicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;600&display=swap" />

    <style is:global>
        @import '../styles/global.scss';
        @import '../styles/animations.scss';
        @import '../styles/navbar.scss';
        @import '../styles/hero.scss';
        @import '../styles/article-card.scss';
        @import '../styles/article-detail.scss';
        @import '../styles/sidebar.scss';
        @import '../styles/moments.scss';
        @import '../styles/utilities.scss';
    </style>

    <script is:inline>
        (function() {
            var saved = null;
            try { saved = localStorage.getItem('StackColorScheme'); } catch(e) {}
            if (saved === 'dark' || saved === 'light') {
                document.documentElement.setAttribute('data-scheme', saved);
            } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                document.documentElement.setAttribute('data-scheme', 'dark');
            }
        })();
    </script>
</head>
<body class={pageClass} data-worker-url={workerUrl}>
    <div class="bw-fullscreen-tip" id="bw-fullscreen-tip">
        <span class="bw-fullscreen-tip__icon">⊡</span>
        <span class="bw-fullscreen-tip__text">按 <kbd>F11</kbd> 全屏浏览效果更佳</span>
        <button class="bw-fullscreen-tip__close" id="bw-fullscreen-tip-close" aria-label="关闭">&times;</button>
    </div>

    <!-- Navbar: fingerprint trigger + expandable bar -->
    <div class="bw-navbar-wrapper" id="bw-navbar-wrapper">
        <div class="bw-navbar-trigger" id="bw-navbar-trigger">
            <svg class="bw-navbar-trigger__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2z"/>
                <path d="M12 6c-3.3 0-6 2.7-6 6s2.7 6 6 6 6-2.7 6-6-2.7-6-6-6z"/>
                <path d="M12 10c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/>
                <path d="M7.5 7.5c.8.8 1.3 1.8 1.5 2.8"/>
                <path d="M15 9c.2-1 .7-2 1.5-2.8"/>
                <path d="M9 15c-.2 1-.7 2-1.5 2.8"/>
                <path d="M16.5 16.5c-.8-.8-1.3-1.8-1.5-2.8"/>
                <path d="M12 2v4"/>
                <path d="M12 18v4"/>
                <path d="M2 12h4"/>
                <path d="M18 12h4"/>
            </svg>
        </div>
        <nav class="bw-navbar" id="bw-navbar">
            <a class="bw-navbar__logo" href="/">
                <div class="bw-navbar__avatar"><img src="/img/avatar.png" alt="Avatar" /></div>
                <span class="bw-navbar__title">{siteTitle}</span>
            </a>
            <div class="bw-navbar__nav">
                {navItems.map(item => (
                    <a class={`bw-navbar__link ${activeNav === item.id ? 'is-active' : ''}`} href={item.href}>{item.label}</a>
                ))}
            </div>
            <div class="bw-navbar__actions">
                <button class="bw-navbar__btn" title="搜索" onclick="location.href='/search'">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                </button>
                <button class="bw-navbar__btn" title="切换主题" onclick="window.__toggleScheme()">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                </button>
                <button class="bw-navbar__btn" id="bw-feature-btn" title="功能面板">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                </button>
            </div>
        </nav>
    </div>

    <!-- Feature Panel Overlay -->
    <div class="bw-feature-overlay" id="bw-feature-overlay"></div>

    <!-- Feature Panel -->
    <div class="bw-feature-panel" id="bw-feature-panel">
        <div class="bw-feature-panel__header">
            <span class="bw-feature-panel__title">功能设置</span>
            <button class="bw-feature-panel__close" onclick="document.getElementById('bw-feature-panel').classList.remove('is-open');document.getElementById('bw-feature-overlay').classList.remove('is-open');">&times;</button>
        </div>
        <div class="bw-feature-panel__body">
            <div class="bw-feature-item">
                <span class="bw-feature-item__label">字体切换</span>
                <button class="bw-feature-item__btn" id="bw-font-switch">切换</button>
            </div>
            <div class="bw-feature-item">
                <span class="bw-feature-item__label">评论显示</span>
                <label class="bw-feature-item__toggle">
                    <input type="checkbox" checked id="bw-comment-toggle" />
                    <span class="bw-feature-item__slider"></span>
                </label>
            </div>
        </div>
    </div>

    <!-- Page Content -->
    <slot />

    <!-- Footer -->
    <footer class="bw-footer">
        <div class="bw-api-usage" id="bw-api-usage" style="display:none">
            <!-- GLM 用量 -->
            <div class="bw-api-row">
                <div class="bw-api-label">
                    <span class="bw-api-dot bw-api-dot--glm"></span>
                    <span>GLM-4-Flash</span>
                </div>
                <div class="bw-api-track"><div class="bw-api-bar" id="bw-glm-bar"></div></div>
                <span class="bw-api-nums"><span id="bw-glm-used">--</span><span> / 200万 tokens</span></span>
            </div>
            <!-- 百度 API 用量 -->
            <div class="bw-api-row">
                <div class="bw-api-label">
                    <span class="bw-api-dot bw-api-dot--baidu"></span>
                    <span>百度 API</span>
                </div>
                <div class="bw-api-track"><div class="bw-api-bar" id="bw-baidu-bar"></div></div>
                <span class="bw-api-nums"><span id="bw-baidu-used">--</span><span> 次调用</span></span>
            </div>
        </div>
        <p>&copy; 2026 {siteTitle} · 本站已苟活 <span id="bw-runtime">0 天</span></p>
        <p>Powered by <a href="https://astro.build" target="_blank" rel="noopener">Astro</a></p>
    </footer>

    <script is:inline>
    (function() {
        var workerUrl = document.body.dataset.workerUrl;
        if (!workerUrl) return;

        function renderUsage(id, d) {
            var usedEl = document.getElementById('bw-' + id + '-used');
            var barEl = document.getElementById('bw-' + id + '-bar');
            var wrap = document.getElementById('bw-api-usage');
            if (wrap) wrap.style.display = '';
            if (usedEl) usedEl.textContent = (d.used || 0).toLocaleString();
            if (barEl) {
                var pct = Math.min(100, d.percent || 0);
                barEl.style.width = pct + '%';
                if (pct > 90) barEl.classList.add('is-danger');
                else if (pct > 70) barEl.classList.add('is-warn');
            }
        }

        fetch(workerUrl + '/api/usage')
            .then(function(r) { return r.json(); })
            .then(function(d) {
                // GLM
                renderUsage('glm', d.glm || { used: 0, percent: 0 });
                // Baidu
                renderUsage('baidu', d.baidu || { used: 0, percent: 0 });
            })
            .catch(function() {
                var wrap = document.getElementById('bw-api-usage');
                if (wrap) {
                    wrap.style.display = '';
                    wrap.classList.add('is-offline');
                }
            });
    })();
    </script>

    <!-- Global Scripts -->
    <script is:inline>
        (function() {
            var SCHEME_KEY = 'StackColorScheme';

            function toggleScheme() {
                var html = document.documentElement;
                var current = html.getAttribute('data-scheme');
                var next = (current === 'dark') ? 'light' : 'dark';
                html.setAttribute('data-scheme', next);
                try { localStorage.setItem(SCHEME_KEY, next); } catch(e) {}
            }
            window.__toggleScheme = toggleScheme;

            // Navbar scroll
            var navbarWrapper = document.getElementById('bw-navbar-wrapper');
            if (navbarWrapper) {
                var ticking = false;
                function updateNavbar() {
                    if (window.scrollY > 60) navbarWrapper.classList.add('is-scrolled');
                    else navbarWrapper.classList.remove('is-scrolled');
                    ticking = false;
                }
                window.addEventListener('scroll', function() {
                    if (!ticking) { requestAnimationFrame(updateNavbar); ticking = true; }
                }, { passive: true });
            }

            // Scroll reveal
            if ('IntersectionObserver' in window) {
                var io = new IntersectionObserver(function(entries) {
                    entries.forEach(function(entry) {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('is-revealed');
                            io.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.05, rootMargin: '0px 0px 0px 0px' });
                document.querySelectorAll('.bw-reveal').forEach(function(el) { io.observe(el); });
            }

            // Runtime counter
            var runtimeEl = document.getElementById('bw-runtime');
            if (runtimeEl) {
                var blogStart = new Date(2026, 0, 1);
                function updateRuntime() {
                    var now = new Date();
                    var diff = now - blogStart;
                    var days = Math.floor(diff / 86400000);
                    var hours = Math.floor((diff % 86400000) / 3600000);
                    var mins = Math.floor((diff % 3600000) / 60000);
                    var secs = Math.floor((diff % 60000) / 1000);
                    runtimeEl.textContent = days + ' 天 ' + hours + ' 时 ' + mins + ' 分 ' + secs + ' 秒';
                }
                updateRuntime();
                setInterval(updateRuntime, 1000);
            }

            // Feature panel toggle
            var panelBtn = document.getElementById('bw-feature-btn');
            var panel = document.getElementById('bw-feature-panel');
            var panelOverlay = document.getElementById('bw-feature-overlay');
            if (panelBtn && panel) {
                panelBtn.addEventListener('click', function() {
                    panel.classList.toggle('is-open');
                    if (panelOverlay) panelOverlay.classList.toggle('is-open');
                });
                if (panelOverlay) {
                    panelOverlay.addEventListener('click', function() {
                        panel.classList.remove('is-open');
                        panelOverlay.classList.remove('is-open');
                    });
                }
            }

            var tipEl = document.getElementById('bw-fullscreen-tip');
            var tipClose = document.getElementById('bw-fullscreen-tip-close');
            if (tipEl && tipClose) {
                function isFullscreen() {
                    return !!(document.fullscreenElement || (window.innerWidth >= screen.width * 0.95 && window.innerHeight >= screen.height * 0.92));
                }
                var TIP_KEY = 'bw-f11-tip-dismissed';
                var dismissed = null;
                try { dismissed = localStorage.getItem(TIP_KEY); } catch(e) {}
                if (!dismissed && !isFullscreen()) {
                    setTimeout(function() { tipEl.classList.add('is-visible'); }, 2000);
                }
                tipClose.addEventListener('click', function() {
                    tipEl.classList.remove('is-visible');
                    try { localStorage.setItem(TIP_KEY, Date.now()); } catch(e) {}
                });
            }

            // Font switcher
            var fontBtn = document.getElementById('bw-font-switch');
            if (fontBtn) {
                var currentFont = localStorage.getItem('bw-font') || 'default';
                if (currentFont === 'serif') document.body.style.fontFamily = '"LXGW WenKai", "Noto Sans SC", serif';
                fontBtn.addEventListener('click', function() {
                    currentFont = currentFont === 'default' ? 'serif' : 'default';
                    localStorage.setItem('bw-font', currentFont);
                    if (currentFont === 'serif') {
                        document.body.style.fontFamily = '"LXGW WenKai", "Noto Sans SC", serif';
                    } else {
                        document.body.style.fontFamily = '';
                    }
                });
            }
        })();
    </script>

    <!-- Live2D 看板娘（L2Dwidget + 拖动 + 工具栏） -->
    <script is:inline>
      (function() {
        var MODELS = [
          { name: '黑猫', path: 'https://cdn.jsdelivr.net/npm/live2d-widget-model-hijiki@1.0.5/assets/hijiki.model.json' },
          { name: '白猫', path: 'https://cdn.jsdelivr.net/npm/live2d-widget-model-tororo@1.0.5/assets/tororo.model.json' },
          { name: '小黄鸡', path: 'https://cdn.jsdelivr.net/npm/live2d-widget-model-koharu@1.0.5/assets/koharu.model.json' },
          { name: '蓝发少女', path: 'https://cdn.jsdelivr.net/npm/live2d-widget-model-shizuku@1.0.5/assets/shizuku.model.json' },
          { name: '初音未来', path: 'https://cdn.jsdelivr.net/npm/live2d-widget-model-miku@1.0.5/assets/miku.model.json' },
          { name: '小春', path: 'https://cdn.jsdelivr.net/npm/live2d-widget-model-haru@1.0.5/assets/haru.model.json' },
          { name: '响', path: 'https://cdn.jsdelivr.net/npm/live2d-widget-model-hibiki@1.0.5/assets/hibiki.model.json' },
          { name: '和泉', path: 'https://cdn.jsdelivr.net/npm/live2d-widget-model-izumi@1.0.5/assets/izumi.model.json' },
          { name: '千岁', path: 'https://cdn.jsdelivr.net/npm/live2d-widget-model-chitose@1.0.5/assets/chitose.model.json' },
          { name: '汪子', path: 'https://cdn.jsdelivr.net/npm/live2d-widget-model-wanko@1.0.5/assets/wanko.model.json' },
          { name: '沉木', path: 'https://cdn.jsdelivr.net/npm/live2d-widget-model-tsumiki@1.0.5/assets/tsumiki.model.json' },
          { name: 'Epsilon', path: 'https://cdn.jsdelivr.net/npm/live2d-widget-model-epsilon2_1@1.0.5/assets/epsilon2_1.model.json' },
        ];
        var currentModel = parseInt(localStorage.getItem('bw-live2d-model') || '0', 10);
        if (currentModel >= MODELS.length) currentModel = 0;

        function getToolbarHTML(name) {
          var opts = MODELS.map(function(m, i) {
            var cls = i === currentModel ? ' bw-model-btn--active' : '';
            return '<button data-model-idx="' + i + '" class="bw-model-btn' + cls + '">' + m.name + '</button>';
          }).join('');
          var collapsed = localStorage.getItem('bw-models-collapsed') !== 'false';
          return '<div id="bw-live2d-toolbar" class="' + (collapsed ? 'bw-toolbar--collapsed' : '') + '">' +
            '<button id="bw-model-toggle" title="收起/展开模型列表">🎭</button>' +
            '<button data-live2d-dir="-1" title="上一个">◀</button>' +
            '<span class="bw-model-list">' + opts + '</span>' +
            '<button data-live2d-dir="1" title="下一个">▶</button>' +
            '<button id="bw-live2d-drag" title="拖动">✥</button>' +
            '</div>';
        }

        var s = document.createElement('script');
        s.src = 'https://cdn.jsdelivr.net/npm/live2d-widget@3.0.4/lib/L2Dwidget.min.js';
        s.onload = function() {
          function loadModel(idx) {
            currentModel = idx;
            localStorage.setItem('bw-live2d-model', idx);
            var old = document.getElementById('live2d-widget');
            if (old) old.remove();
            var oldToolbar = document.getElementById('bw-live2d-toolbar');
            if (oldToolbar) oldToolbar.remove();
            var vw = window.innerWidth;
            var scale = vw < 768 ? 0.6 : vw < 1200 ? 0.85 : 1;
            var w = Math.round(90 * scale);
            var h = Math.round(125 * scale);
            L2Dwidget.init({
              model: { jsonPath: MODELS[idx].path },
              display: { superSample: 2, width: w, height: h, position: 'right', hOffset: 10, vOffset: -40 },
              mobile: { show: true },
              react: { opacityDefault: 0.85 },
            });
            setTimeout(function() { setupWidget(idx); }, 1000);
          }

          window.__live2dSwitchToModel = function(idx) {
            if (idx >= 0 && idx < MODELS.length) loadModel(idx);
          };
          window.__live2dSwitchModel = function(dir) {
            var next = (currentModel + dir + MODELS.length) % MODELS.length;
            loadModel(next);
          };

          loadModel(currentModel);
        };
        s.onerror = function() {};
        document.head.appendChild(s);

        function setupWidget(idx) {
          // 先插入工具栏（固定定位兜底）
          var existing = document.getElementById('bw-live2d-toolbar');
          if (!existing) {
            document.body.insertAdjacentHTML('beforeend', getToolbarHTML(MODELS[idx].name));
          }
          var toolbar = document.getElementById('bw-live2d-toolbar');
          var widget = document.getElementById('live2d-widget');
          if (!widget) return;

          // nameEl replaced by inline buttons
          // updated via getToolbarHTML rebuild

          // 工具栏使用 CSS fixed 定位，无需 JS 同步

          if (toolbar && toolbar.getAttribute('data-bound') !== 'true') {
            toolbar.setAttribute('data-bound', 'true');
            toolbar.addEventListener('click', function(e) {
              var target = e.target;
              if (!target) return;
              // 切换模型列表展开/收起
              if (target.id === 'bw-model-toggle') {
                e.preventDefault();
                e.stopPropagation();
                toolbar.classList.toggle('bw-toolbar--collapsed');
                localStorage.setItem('bw-models-collapsed', toolbar.classList.contains('bw-toolbar--collapsed'));
                return;
              }
              // 点击模型名字切换
              var modelIdx = target.getAttribute('data-model-idx');
              if (modelIdx !== null) {
                e.preventDefault();
                e.stopPropagation();
                window.__live2dSwitchToModel(parseInt(modelIdx, 10));
                return;
              }
              var dir = target.getAttribute('data-live2d-dir');
              if (dir !== null) {
                e.preventDefault();
                e.stopPropagation();
                window.__live2dSwitchModel(parseInt(dir, 10));
              }
            });
          }

          var dragMode = false;
          var dragBtn = document.getElementById('bw-live2d-drag');
          var startX, startY, origX, origY;

          if (dragBtn && dragBtn.getAttribute('data-bound') !== 'true') {
            dragBtn.setAttribute('data-bound', 'true');
            dragBtn.addEventListener('click', function(e) {
              e.preventDefault();
              e.stopPropagation();
              dragMode = !dragMode;
              dragBtn.classList.toggle('is-active', dragMode);
              var canvas = widget.querySelector('canvas');
              if (canvas) canvas.style.cursor = dragMode ? 'grabbing' : 'grab';
            });
          }

          widget.onmousedown = function(e) {
            if (!dragMode) return;
            startX = e.clientX; startY = e.clientY;
            var rect = widget.getBoundingClientRect();
            origX = rect.left; origY = rect.top;
            e.preventDefault();

            function onMove(e) {
              var dx = e.clientX - startX, dy = e.clientY - startY;
              widget.style.position = 'fixed';
              widget.style.left = (origX + dx) + 'px';
              widget.style.top = (origY + dy) + 'px';
              widget.style.right = 'auto';
              widget.style.bottom = 'auto';
              syncToolbar();
            }
            function onUp() {
              document.removeEventListener('mousemove', onMove);
              document.removeEventListener('mouseup', onUp);
              syncToolbar();
            }
            document.addEventListener('mousemove', onMove);
            document.addEventListener('mouseup', onUp);
          };

          document.addEventListener('click', function(ev) {
            var g = document.getElementById('bw-live2d-grid');
            if (g && !g.contains(ev.target) && ev.target.id !== 'bw-live2d-picker') {
              g.classList.remove('is-open');
            }
          });
          widget.setAttribute('data-bw-ready', 'true');
          var evt = new CustomEvent('bw-live2d-ready');
          document.dispatchEvent(evt);
        }
      })();
    </script>

    <!-- KaTeX client-side render for AI text -->
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"></script>
    <script is:inline>
      window.__renderMathInEl = function(el) {
        if (!el || typeof renderMathInElement === 'undefined') return;
        try {
          renderMathInElement(el, {
            delimiters: [
              {left: '$$', right: '$$', display: true},
              {left: '$', right: '$', display: false},
            ],
            throwOnError: false,
          });
        } catch(e) {}
      };
    </script>
</body>
</html>

<style>
    .bw-feature-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.4);
        z-index: 999;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }
