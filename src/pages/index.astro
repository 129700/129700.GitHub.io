---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const totalPosts = allPosts.length;
const allTags = new Set(allPosts.flatMap(p => p.data.tags));
const totalTags = allTags.size;

const categoryMap = new Map<string, number>();
allPosts.forEach(p => {
    p.data.categories.forEach(c => {
        categoryMap.set(c, (categoryMap.get(c) || 0) + 1);
    });
});

import momentsData from '../data/moments.json';
const moments: Array<{date: string; text: string}> = momentsData || [];

const catIcons: Record<string, string> = {
    '项目': '\u{1F9EA}', '学习': '\u{1F4DA}', '教程': '\u{1F4D6}', '读书': '\u{1F4D5}', '笔记': '\u{1F4DD}',
    '控制理论': '\u{1F4D0}', '嵌入式': '\u2699\uFE0F',
};

const blogStart = new Date(2026, 0, 1);
const blogDays = Math.max(1, Math.floor((Date.now() - blogStart.getTime()) / 86400000));
---

<BaseLayout title="129700 的笔记站" pageClass="page-home" activeNav="home">
    <!-- ============================================
         Lumora Landing Hero
         ============================================ -->
    <section class="lumora-hero" id="lumora-hero">
        <!-- Video backgrounds (auto-cycle) -->
        <video class="lumora-hero__video" src="https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260702_081127_0992a171-d3c6-4978-8213-0ec5df8b6d63.mp4" autoplay muted loop playsinline></video>
        <video class="lumora-hero__video" src="https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260702_092026_dd05b805-ea0f-40b2-8c52-332b88502592.mp4" autoplay muted loop playsinline></video>
        <video class="lumora-hero__video" src="https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260702_081042_df7202bf-bd80-4b2b-bbc6-1f09ba2870e9.mp4" autoplay muted loop playsinline></video>
        <video class="lumora-hero__video" src="https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260702_080959_4cac5234-3573-464e-a5b7-76b94b8a7d61.mp4" autoplay muted loop playsinline></video>
        <!-- Video channel labels -->
        <div class="lumora-hero__channels">
            <span class="lumora-hero__channel" data-idx="0">CH1 · Golden Hour</span>
            <span class="lumora-hero__channel" data-idx="1">CH2 · Still Water</span>
            <span class="lumora-hero__channel" data-idx="2">CH3 · Deep Woods</span>
            <span class="lumora-hero__channel" data-idx="3">CH4 · Quiet Dawn</span>
        </div>
        <!-- Grain overlay -->
        <div class="lumora-hero__grain"></div>
        <!-- PCB dot-grid (signature) -->
        <div class="lumora-hero__grid"></div>
        <!-- Vignette -->
        <div class="lumora-hero__vignette"></div>

        <div class="lumora-hero__content">
            <!-- Tagline badge -->
            <div class="lumora-hero__badge">
                <span class="lumora-hero__badge-dot"></span>
                <span>嵌入式开发 · 控制理论 · 学习笔记</span>
                <span class="lumora-hero__badge-cursor">_</span>
            </div>

            <!-- Visitor greeting -->
            <div class="lumora-hero__greeting">
                <span id="lumora-greeting-text">正在感应来访者...</span>
                <span class="lumora-hero__greeting-ip">你的 IP 是 <span id="lumora-greeting-ip-val">---.---.---.---</span></span>
            </div>

            <!-- Title -->
            <h1 class="lumora-hero__title">129700</h1>

            <!-- Subtitle -->
            <p class="lumora-hero__sub">
                记录一些学习，一些生活。<br/>
                控制理论、嵌入式开发的学习笔记。偶尔写点生活碎片，写给未来回头看的自己。
            </p>

            <!-- Stats -->
            <div class="lumora-hero__stats">
                <div class="lumora-hero__stat">
                    <span class="lumora-hero__stat-num" id="lumora-stat-posts">{totalPosts}</span>
                    <span class="lumora-hero__stat-label">篇文章</span>
                </div>
                <div class="lumora-hero__stat">
                    <span class="lumora-hero__stat-num" id="lumora-stat-tags">{totalTags}</span>
                    <span class="lumora-hero__stat-label">个标签</span>
                </div>
                <div class="lumora-hero__stat">
                    <span class="lumora-hero__stat-num" id="lumora-stat-days">{blogDays}</span>
                    <span class="lumora-hero__stat-label">天已过</span>
                </div>
            </div>

            <!-- CTA -->
            <a class="lumora-hero__cta" href="#lumora-blog">
                进入博客
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 5v14M5 12l7 7 7-7"/>
                </svg>
            </a>

            <!-- Scroll hint -->
            <div class="lumora-hero__scroll-hint">
                <span>向下滚动</span>
                <div class="lumora-hero__scroll-line"></div>
            </div>
        </div>
    </section>

    <!-- ============================================
         Blog Content (below the fold)
         ============================================ -->
    <div id="lumora-blog" class="page-wrapper">
        <aside class="page-sidebar-left">
            <div class="sidebar-left__section">
                <div class="sidebar-left__title">分类</div>
                <ul class="sidebar-left__categories">
                    {Array.from(categoryMap.entries()).map(([cat, count]) => (
                        <li>
                            <a class="sidebar-left__cat" href={`/categories/${cat}`}>
                                <span>{catIcons[cat] || '\u{1F4C2}'} {cat}</span>
                                <span class="sidebar-left__cat-count">{count}</span>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
            <div class="sidebar-left__section">
                <div class="sidebar-left__title">标签</div>
                <div class="sidebar-left__tags">
                    {Array.from(allTags).map((tag) => (
                        <a class="sidebar-left__tag" href={`/tags/${tag}`}>#{tag}</a>
                    ))}
                </div>
            </div>
        </aside>

        <div class="page-content-area">
            {categoryMap.size > 0 && (
                <section class="bw-reveal">
                    <div class="bw-section-head"><span class="bw-section-title">精选分类</span></div>
                    <div class="bw-categories-grid">
                        {Array.from(categoryMap.entries()).slice(0, 4).map(([cat, count]) => {
                            const catPosts = sortedPosts.filter(p => p.data.categories.includes(cat)).slice(0, 2);
                            return (
                                <div class="bw-cat">
                                    <div class="bw-cat__header">
                                        <span class="bw-cat__icon">{catIcons[cat] || '\u{1F4C2}'}</span>
                                        <div>
                                            <div class="bw-cat__name">{cat}</div>
                                            <div class="bw-cat__count">{count} 篇文章</div>
                                        </div>
                                    </div>
                                    <div class="bw-cat__articles">
                                        {catPosts.map(post => (
                                            <a class="bw-cat__article" href={`/post/${post.id}`}>
                                                <span>{post.data.title}</span>
                                                <span class="bw-cat__article-date">{post.data.date.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' })}</span>
                                            </a>
                                        ))}
                                    </div>
                                    <a class="bw-cat__more" href={`/categories/${cat}`}>查看全部 &rarr;</a>
                                </div>
                            );
                        })}
                    </div>
                </section>
            )}

            {moments.length > 0 && (
                <section class="bw-moments bw-reveal">
                    <div class="bw-section-head">
                        <span class="bw-section-title">瞬间</span>
                        <span class="bw-section-sub">碎碎念</span>
                    </div>
                    <div class="bw-moments__grid">
                        {moments.map((m) => (
                            <div class="bw-moment">
                                <div class="bw-moment__date">{m.date}</div>
                                <div class="bw-moment__text">{m.text}</div>
                            </div>
                        ))}
                    </div>
                </section>
            )}

            <section class="bw-reveal">
                <div class="bw-section-head"><span class="bw-section-title">最新文章</span></div>
                <div class="bw-article-grid">
                    {sortedPosts.slice(0, 8).map((post) => (
                        <a class="bw-article-card" href={`/post/${post.id}`}>
                            {post.data.image && <img class="bw-article-card__image" src={post.data.image} alt="" loading="lazy" />}
                            <div class="bw-article-card__body">
                                <div class="bw-article-card__date">{post.data.date.toLocaleDateString('zh-CN')}</div>
                                <h3 class="bw-article-card__title">{post.data.title}</h3>
                                <p class="bw-article-card__excerpt">{post.data.description || ''}</p>
                                <div class="bw-article-card__tags">
                                    {post.data.tags.slice(0, 3).map((tag: string) => (
                                        <span class="bw-article-card__tag">#{tag}</span>
                                    ))}
                                </div>
                            </div>
                        </a>
                    ))}
                </div>
            </section>

            <section class="bw-reveal">
                <div class="bw-section-head">
                    <span class="bw-section-title">同频者</span>
                    <span class="bw-section-sub">友链</span>
                </div>
                <div class="bw-friends-row">
                    <a class="bw-friend-link" href="https://baiwumm.com/" target="_blank" rel="noopener">谜叶象限</a>
                    <a class="bw-friend-link" href="https://blog.liushen.fun/" target="_blank" rel="noopener">清羽飞扬</a>
                    <a class="bw-friend-link" href="https://www.robomaster.com/" target="_blank" rel="noopener">RoboMaster</a>
                    <a class="bw-friend-link" href="https://haki-haki-haki.github.io/myblog_new/?p=index" target="_blank" rel="noopener">Haki Blog</a>
                    <a class="bw-friend-link" href="/links">更多友链 &rarr;</a>
                </div>
            </section>
        </div>

        <aside class="page-sidebar-right">
            <div class="sidebar-right__section">
                <div class="sidebar-right__title">网站信息</div>
                <div class="sidebar-right__stat">
                    <span class="sidebar-right__stat-label">文章数目</span>
                    <span class="sidebar-right__stat-value">{totalPosts}</span>
                </div>
                <div class="sidebar-right__stat">
                    <span class="sidebar-right__stat-label">标签数目</span>
                    <span class="sidebar-right__stat-value">{totalTags}</span>
                </div>
            </div>
        </aside>
    </div>

    <!-- Live2D -->
    <div class="bw-pet" id="bw-pet">
        <div class="bw-pet__bubble" id="bw-pet-bubble">
            <span class="bw-pet__bubble-text" id="bw-pet-text">正在感应来访者...</span>
            <span class="bw-pet__bubble-tail"></span>
        </div>
    </div>

    <script is:inline>
        (function() {
            // === Landing page animations ===
            var hero = document.getElementById('lumora-hero');
            if (hero) {
                requestAnimationFrame(function() {
                    hero.classList.add('is-loaded');
                });
            }

            // === Video auto-cycle ===
            var videos = document.querySelectorAll('.lumora-hero__video');
            var channels = document.querySelectorAll('.lumora-hero__channel');
            var videoIdx = 0;
            if (videos.length > 0) {
                videos[0].classList.add('is-active');
                if (channels[0]) channels[0].classList.add('is-active');
                setInterval(function() {
                    videos[videoIdx].classList.remove('is-active');
                    if (channels[videoIdx]) channels[videoIdx].classList.remove('is-active');
                    videoIdx = (videoIdx + 1) % videos.length;
                    videos[videoIdx].classList.add('is-active');
                    if (channels[videoIdx]) channels[videoIdx].classList.add('is-active');
                }, 8000);
            }

            // Smooth scroll for CTA
            var cta = document.querySelector('.lumora-hero__cta');
            if (cta) {
                cta.addEventListener('click', function(e) {
                    e.preventDefault();
                    var target = document.getElementById('lumora-blog');
                    if (target) target.scrollIntoView({ behavior: 'smooth' });
                });
            }

            // === Greeting / IP logic ===
            var bloggerLat = 34.26, bloggerLng = 108.94;
            var TENCENT_KEY = 'C3EBZ-CFS37-HVBX3-HJFP2-CDOSS-PDFI5';
            var WORKER_URL = document.body.dataset.workerUrl || '';

            var petText = document.getElementById('bw-pet-text');
            var petBubble = document.getElementById('bw-pet-bubble');

            var hour = new Date().getHours();
            var timeGreet, timeEmoji;
            if (hour < 6) { timeGreet = '夜深了'; timeEmoji = '\u{1F319}'; }
            else if (hour < 9) { timeGreet = '早上好'; timeEmoji = '\u{1F305}'; }
            else if (hour < 12) { timeGreet = '上午好'; timeEmoji = '\u2600\uFE0F'; }
            else if (hour < 14) { timeGreet = '中午好'; timeEmoji = '\u{1F31E}'; }
            else if (hour < 18) { timeGreet = '下午好'; timeEmoji = '\u{1F55E}'; }
            else if (hour < 22) { timeGreet = '晚上好'; timeEmoji = '\u{1F306}'; }
            else { timeGreet = '夜深了'; timeEmoji = '\u{1F319}'; }

            function showBubble(msg) {
                if (petText) { petText.innerHTML = msg; window.__renderMathInEl(petText); }
                if (petBubble) petBubble.classList.add('is-visible');
            }
            function fallback() { showBubble(timeEmoji + ' ' + timeGreet + '\uFF01'); }

            var quotes = [
                '路漫漫其修远兮，吾将上下而求索。 \u2014 屈原',
                '学而不思则罔，思而不学则殆。 \u2014 孔子',
                '千里之行，始于足下。 \u2014 老子',
                '不积跬步，无以至千里。 \u2014 荀子',
                '业精于勤，荒于嬉。 \u2014 韩愈',
                '天行健，君子以自强不息。 \u2014 《周易》',
                '纸上得来终觉浅，绝知此事要躬行。 \u2014 陆游',
                '博观而约取，厚积而薄发。 \u2014 苏轼',
                '宝剑锋从磨砺出，梅花香自苦寒来。 \u2014 古训',
                '代码是写给人看的，只是恰好能被机器执行。 \u2014 Harold Abelson',
                '简单是可靠的先决条件。 \u2014 Edsger Dijkstra',
                '过早优化是万恶之源。 \u2014 Donald Knuth',
                '任何足够先进的技术，都与魔法无异。 \u2014 Arthur C. Clarke',
                '调试比编写代码难两倍。',
            ];

            var chatTopics = [
                '今日AI领域有什么有趣的新进展？用一句话总结，卖萌语气，30字以内。',
                '最近有什么好玩的科技新闻？用一句话告诉喵，卖萌语气，30字以内。',
                '给来访者推荐一个编程小技巧吧，卖萌语气，30字以内。',
                '分享一个关于AI的冷知识，卖萌语气，30字以内。',
                '推荐一本技术书籍，卖萌语气，25字以内。',
            ];

            var isInitialGreet = true, chatCounter = 0;

            function askAI(loc, dist, extra) {
                var prompt = '你是一只可爱的小黑猫管家。一位来自' + loc + '的访客正在访问博客' + (dist ? '，距西安约' + dist + '公里' : '') + '。现在是' + timeGreet + '。' + (extra || '') + '请用一句话欢迎这位访客，要包含当地特色（美食/文化/风景），语气可爱卖萌，25字以内，末尾加一个emoji。只输出这句话，不要其他内容。';
                fetch(WORKER_URL + '/api/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ prompt: prompt, max_tokens: 60, temperature: 0.95 })
                }).then(function(r) { return r.json(); })
                  .then(function(data) {
                      if (data.answer) showBubble(data.answer);
                      else showBubble(timeEmoji + ' ' + timeGreet + '\uFF01');
                  }).catch(function() { showBubble(timeEmoji + ' ' + timeGreet + '\uFF01'); });
            }

            function pushRandomChat() {
                isInitialGreet = false;
                chatCounter++;
                if (chatCounter % 2 === 1) {
                    var q = quotes[Math.floor(Math.random() * quotes.length)];
                    showBubble('\u{1F4D6} ' + q);
                } else {
                    var topic = chatTopics[Math.floor(Math.random() * chatTopics.length)];
                    fetch(WORKER_URL + '/api/chat', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ prompt: '你是一只可爱的小黑猫管家，住在技术博客里。' + topic + '末尾加一个emoji。只输出这句话。', max_tokens: 60, temperature: 0.95 })
                    }).then(function(r) { return r.json(); })
                      .then(function(data) {
                          if (data.answer) showBubble(data.answer);
                          else showBubble('\u{1F4D6} ' + quotes[Math.floor(Math.random() * quotes.length)]);
                      }).catch(function() {
                          showBubble('\u{1F4D6} ' + quotes[Math.floor(Math.random() * quotes.length)]);
                      });
                }
            }

            function updateGreetingText(loc, ip) {
                var el = document.getElementById('lumora-greeting-text');
                if (el) el.textContent = '来自 ' + loc + ' 的访客 · ' + timeEmoji + ' ' + timeGreet;
                var ipEl = document.getElementById('lumora-greeting-ip-val');
                if (ipEl && ip) ipEl.textContent = ip;
            }

            window.qqLocationCallback = function(res) {
                if (res && res.status === 0 && res.result && res.result.ad_info) {
                    var info = res.result.ad_info;
                    var loc = (info.province || '') + (info.city && info.city !== info.province ? info.city : '');
                    if (!loc) { tryPconline(); return; }
                    var ip = res.result.ip || '';
                    updateGreetingText(loc, ip);
                    askAI(loc, '', '');
                } else { tryPconline(); }
            };

            window.IPCallBack = function(d) {
                if (d && (d.pro || d.city)) {
                    var loc = (d.pro || '') + (d.city && d.city !== d.pro ? d.city : '');
                    var ip = d.cip || '';
                    if (loc) { updateGreetingText(loc, ip); askAI(loc, '', ''); return; }
                }
                fallback();
            };

            function tryPconline() {
                var s2 = document.createElement('script');
                s2.src = 'https://whois.pconline.com.cn/ipJson.jsp';
                s2.onerror = fallback;
                document.head.appendChild(s2);
            }

            var s = document.createElement('script');
            s.src = 'https://apis.map.qq.com/ws/location/v1/ip?key=' + TENCENT_KEY + '&output=jsonp&callback=qqLocationCallback';
            s.onerror = tryPconline;
            document.head.appendChild(s);

            function bindPetClick() {
                var widget = document.getElementById('live2d-widget');
                if (!widget) return false;
                widget.addEventListener('click', function(e) {
                    if (e.target.closest('#bw-live2d-toolbar')) return;
                    if (isInitialGreet) {
                        askAI('远方', '', '换个方式再卖个萌');
                        isInitialGreet = false;
                    } else {
                        pushRandomChat();
                    }
                });
                return true;
            }
            if (!bindPetClick()) {
                document.addEventListener('bw-live2d-ready', bindPetClick);
            }

            setTimeout(function() { isInitialGreet = false; }, 30000);
            setInterval(function() {
                if (!isInitialGreet) pushRandomChat();
            }, 90000);

            // === Count-up animation ===
            function animateNum(el, target, dur) {
                if (!el) return;
                var t0 = performance.now();
                function step(t) {
                    var p = Math.min((t - t0) / dur, 1);
                    var e = 1 - Math.pow(1 - p, 3);
                    el.textContent = Math.floor(target * e);
                    if (p < 1) requestAnimationFrame(step);
                    else el.textContent = target;
                }
                requestAnimationFrame(step);
            }
            var postsEl = document.getElementById('lumora-stat-posts');
            var tagsEl = document.getElementById('lumora-stat-tags');
            var daysEl = document.getElementById('lumora-stat-days');
            if (postsEl) { var v = parseInt(postsEl.textContent) || 0; postsEl.textContent = '0'; animateNum(postsEl, v, 2000); }
            if (tagsEl) { var v = parseInt(tagsEl.textContent) || 0; tagsEl.textContent = '0'; animateNum(tagsEl, v, 2000); }
            if (daysEl) { var v = parseInt(daysEl.textContent) || 0; daysEl.textContent = '0'; animateNum(daysEl, v, 2000); }
        })();
    </script>
</BaseLayout>

<style>
/* =========================================
   Lumora Landing Hero — Tech/Editorial
   ========================================= */
.lumora-hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0D0B09;
    overflow: hidden;
}

/* Video layers */
.lumora-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
}
.lumora-hero__video.is-active { opacity: 1; }

/* Channel labels (oscilloscope-style) */
.lumora-hero__channels {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    gap: 16px;
}
.lumora-hero__channel {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: rgba(255,255,255,0.25);
    letter-spacing: 0.5px;
    transition: color 0.8s ease;
}
.lumora-hero__channel.is-active {
    color: rgba(200,164,92,0.7);
}

/* Grain */
.lumora-hero__grain {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0.035;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
}

/* PCB dot-grid (signature element) */
.lumora-hero__grid {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0.04;
    background-image: radial-gradient(circle, rgba(200,164,92,0.5) 0.5px, transparent 0.5px);
    background-size: 24px 24px;
}

