---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
    const allPosts = await getCollection('posts');
    const tagMap = new Map<string, typeof allPosts>();
    allPosts.forEach(post => {
        post.data.tags.forEach(tag => {
            if (!tagMap.has(tag)) tagMap.set(tag, []);
            tagMap.get(tag)!.push(post);
        });
    });
    return Array.from(tagMap.entries()).map(([tag, posts]) => ({
        params: { tag },
        props: { tag, posts: posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()) },
    }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签: ${tag}`} pageClass="page-tag" activeNav="tags">
    <div class="page-wrapper">
        <main class="page-main">
            <div class="post-container page-enter">
                <div class="post-breadcrumb"><a href="/tags">标签</a> / #{tag}</div>
                <h1 class="post-title">#{tag}</h1>
                <p style="color: var(--bw-ink-muted); margin-bottom: 2rem;">{posts.length} 篇文章</p>
                <div class="bw-article-grid">
                    {posts.map(post => (
                        <a class="bw-article-card" href={`/post/${post.id}`}>
                            <div class="bw-article-card__body">
                                <div class="bw-article-card__date">{post.data.date.toLocaleDateString('zh-CN')}</div>
                                <h3 class="bw-article-card__title">{post.data.title}</h3>
                                <p class="bw-article-card__excerpt">{post.data.description || ''}</p>
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        </main>
    </div>
</BaseLayout>
