&lt;/div&gt;&lt;table&gt;
	&lt;thead&gt;
			&lt;tr&gt;
					&lt;th&gt;对比维度&lt;/th&gt;
					&lt;th&gt;PID&lt;/th&gt;
					&lt;th&gt;LQR&lt;/th&gt;
					&lt;th&gt;MPC&lt;/th&gt;
			&lt;/tr&gt;
	&lt;/thead&gt;
	&lt;tbody&gt;
			&lt;tr&gt;
					&lt;td&gt;是否需要模型&lt;/td&gt;
					&lt;td&gt;不需要&lt;/td&gt;
