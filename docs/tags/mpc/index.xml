					&lt;td&gt;局部最优&lt;/td&gt;
					&lt;td&gt;有限时域最优&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;工程应用&lt;/td&gt;
					&lt;td&gt;最广泛&lt;/td&gt;
					&lt;td&gt;较多&lt;/td&gt;
					&lt;td&gt;日益增多&lt;/td&gt;
			&lt;/tr&gt;
	&lt;/tbody&gt;
